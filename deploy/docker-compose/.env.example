# Use immutable image references. Never use mutable tags for evidence runs.
BLOC_IMAGE=bloc-node@sha256:replace-with-64-hex-digest
MEMPOOL_IMAGE=mempool-il@sha256:replace-with-64-hex-digest

# All inputs are generated and verified before startup, then mounted read-only.
BLOC_CLUSTER_CONFIG=./generated/n4/cluster.json
BLOC_CLUSTER_CRS=./generated/n4/cluster.crs
BLOC_ENCRYPTED_CORPUS=./generated/n4/encrypted-corpus.json
BLOC_SECRET_0=./generated/n4/secrets/operator-0.json
BLOC_SECRET_1=./generated/n4/secrets/operator-1.json
BLOC_SECRET_2=./generated/n4/secrets/operator-2.json
BLOC_SECRET_3=./generated/n4/secrets/operator-3.json
