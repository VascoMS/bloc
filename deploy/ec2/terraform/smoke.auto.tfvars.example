node_count               = 4
operator_instance_type   = "t3.micro"
controller_instance_type = "t3.small"
ecr_repository_arns = [
  "arn:aws:ecr:us-east-1:123456789012:repository/bloc-node",
  "arn:aws:ecr:us-east-1:123456789012:repository/mempool-il",
]

# Fill these in locally in smoke.auto.tfvars. Do not commit that file.
key_name    = "replace-with-existing-ec2-key-pair"
admin_cidrs = ["replace-with-your-public-ip/32"]
